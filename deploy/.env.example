# Copy to .env next to deploy/compose.yaml. Never commit real keys.
# LiteLLM refuses to start with this value empty: every request would otherwise
# be accepted unauthenticated. Generate one: openssl rand -hex 24
LITELLM_MASTER_KEY=
# The old placeholder sk-change-me is a working credential, not a sentinel, so
# it would silently authenticate anyone who guessed it. Leave this empty until
# you have a real key.
# MiniMax M Plan / pay-as-you-go key; read by litellm-config.yaml.
MINIMAX_API_KEY=
